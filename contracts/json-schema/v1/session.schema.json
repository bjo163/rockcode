{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rockcode.dev/contracts/json-schema/v1/session.schema.json",
  "title": "RockCode Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "workspace_id",
    "title",
    "status",
    "owner_id",
    "created_at",
    "updated_at",
    "current_run_id",
    "version",
    "last_event_seq"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9_-]{16,96}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^wsp_[A-Za-z0-9_-]{16,96}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "idle",
        "running",
        "waiting_approval",
        "waiting_input",
        "waiting_child",
        "queued",
        "disconnected",
        "recovering",
        "completed",
        "failed",
        "cancelled",
        "archived"
      ]
    },
    "owner_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^run_[A-Za-z0-9_-]{16,96}$"
    },
    "agent_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "version"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_id",
        "kind",
        "sandbox_profile"
      ],
      "properties": {
        "executor_id": {
          "type": "string",
          "pattern": "^exe_[A-Za-z0-9_-]{16,96}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "local",
            "container",
            "remote"
          ]
        },
        "sandbox_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
